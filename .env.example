# === AI Providers (isi yang kamu punya, sisanya boleh kosong) ===

# Groq — paling cepat, gratis, no CC — https://console.groq.com
GROQ_API_KEY=

# Gemini — gratis 20 req/hari/key — https://ai.google.dev
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OpenRouter — banyak model free — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral — gratis tier — https://console.mistral.ai
MISTRAL_API_KEY=

# SambaNova — gratis, butuh signup — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# LLM7.io — gratis, pakai 'unused' kalau nggak punya key
LLM7_API_KEY=unused

# === Local LLM (opsional) ===
# Kalau punya server llama.cpp sendiri
LLAMACPP_URL=http://127.0.0.1:8080/v1
LLAMACPP_API_KEY=local

# === Obsidian Vault (opsional) ===
# Path ke vault Obsidian. Kalau kosong, Obsidian skills auto-disable.
# Contoh:
#   Linux/Mac : /home/user/Documents/second-brain
#   Windows   : C:\\Users\\user\\Documents\\second-brain
#   Termux    : /storage/emulated/0/Documents/second-brain
OBSIDIAN_VAULT=
